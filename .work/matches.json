[
 {
  "id": "LU1",
  "name": "中府",
  "n": 1,
  "hits": [
   {
    "line": 2253,
    "text": "肺系急，胸中痛，恶寒，胸满悒悒然，善呕胆，胸中热，喘，逆气，气相追逐，多浊唾，不得息，肩背风，汗出，面腹肿，鬲中食噎，不下食，喉痹，肩息肺胀，皮肤骨，寒热烦满，中府主之"
   }
  ]
 },
 {
  "id": "LU2",
  "name": "云门",
  "n": 4,
  "hits": [
   {
    "line": 2287,
    "text": "暴心腹痛，疝横发上冲心，云门主之"
   },
   {
    "line": 2359,
    "text": "咳喘不得，坐不得卧，呼吸气素，咽不得，胸中热，云门主之"
   },
   {
    "line": 2569,
    "text": "肩痛不可举，引缺盆痛，云门主之"
   },
   {
    "line": 2581,
    "text": "脉代不至寸口，四逆脉鼓不通，云门主之"
   }
  ]
 },
 {
  "id": "LU5",
  "name": "尺泽",
  "n": 6,
  "hits": [
   {
    "line": 2155,
    "text": "，因为 衄，尺泽主之"
   },
   {
    "line": 2343,
    "text": "心膨膨痛（《千金》云烦闷乱），少气不足以息，尺泽主之"
   },
   {
    "line": 2359,
    "text": "咳逆上气，舌干胁痛，心烦肩寒，少气不足以息，腹胀，喘，尺泽主之"
   },
   {
    "line": 2545,
    "text": "手臂不得上头，尺泽主之"
   },
   {
    "line": 2569,
    "text": "肘痛，尺泽主之"
   },
   {
    "line": 2759,
    "text": "喉痹，完骨及天容、气舍、天鼎、尺泽、合谷、商阳、阳溪、中渚、前谷、商丘、然谷、阳交悉主之"
   }
  ]
 },
 {
  "id": "LU7",
  "name": "列缺",
  "n": 3,
  "hits": [
   {
    "line": 2147,
    "text": "热病先手臂螈 ，唇口聚鼻张，目下汗出如转珠，两乳下二寸坚，胁满，悸，列缺主之"
   },
   {
    "line": 2223,
    "text": "疟热盛，列缺主之"
   },
   {
    "line": 2253,
    "text": "寒热咳呕沫，掌中热，虚则肩臂寒栗，少气不足以息，寒厥，交两手而瞀，口沫出，实则肩背热痛，汗出，四肢暴肿，身湿（一本作温）摇，时寒热，饥则烦，饥则善，面色变，口噤不开，恶风泣出，列缺主之"
   }
  ]
 },
 {
  "id": "LU9",
  "name": "太渊",
  "n": 7,
  "hits": [
   {
    "line": 2253,
    "text": "臂厥，肩膺胸满痛，目中白翳，眼青转筋，掌中热，乍寒乍热，缺盆中相引痛，数咳，喘不得息，臂内廉痛，上鬲饮已烦满，太渊主之"
   },
   {
    "line": 2343,
    "text": "脾逆气寒，次急烦心，善唾哕噫，胸满激呼，胃气上逆，心痛（《千金》作肺胀胃逆），太渊主之"
   },
   {
    "line": 2359,
    "text": "咳逆烦闷不得卧，胸中满，喘不得息，背痛，太渊主之"
   },
   {
    "line": 2505,
    "text": "痹，会阴及太渊、消泺、照海主之"
   },
   {
    "line": 2591,
    "text": "狂言，太渊主之"
   },
   {
    "line": 2637,
    "text": "唾血振寒嗌干，太渊主之"
   },
   {
    "line": 2775,
    "text": "妒乳，（《千金》云：膺胸痛）太渊主之"
   }
  ]
 },
 {
  "id": "LU10",
  "name": "鱼际",
  "n": 6,
  "hits": [
   {
    "line": 2147,
    "text": "寒厥及热烦心，少气不足以息，阴湿痒，腹痛不可以食饮，肘挛支满，喉中焦干渴，鱼际主之"
   },
   {
    "line": 2209,
    "text": "上气，鱼际主之"
   },
   {
    "line": 2383,
    "text": "短气心痹，悲怒逆气，怒，狂易，鱼际主之"
   },
   {
    "line": 2591,
    "text": "狂易，鱼际及合谷、腕骨、支正、少海、昆仑主之"
   },
   {
    "line": 2607,
    "text": "胃逆霍乱，鱼际主之"
   },
   {
    "line": 2607,
    "text": "霍乱逆气，鱼际及太白主之"
   }
  ]
 },
 {
  "id": "LU11",
  "name": "少商",
  "n": 2,
  "hits": [
   {
    "line": 2147,
    "text": "热病象疟，振栗鼓颔，腹胀睥睨，喉中鸣，少商主之"
   },
   {
    "line": 2253,
    "text": "寒濯濯，舌烦，手臂不仁，唾沫，唇干引饮，手腕挛，指支痛，肺胀，上气，耳中生风，咳喘逆，痹，臂痛，呕吐，饮食不下膨膨然，少商主之"
   }
  ]
 },
 {
  "id": "LI1",
  "name": "商阳",
  "n": 7,
  "hits": [
